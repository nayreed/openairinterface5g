# SPDX-License-Identifier: LicenseRef-CSSL-1.0

#---------------------------------------------------------------------
#
# Dockerfile for amber-reader and amber-tag (openair2/AMBER) with Amber, and
# rfsim_hub (radio/rfsimulator/hub)
#   Valid for Ubuntu 24.04
#
# One image holds the programs, so a Reader and its Tags always run the
# same OAI and Amber code. Build from the repository root:
#   docker build -f docker/Dockerfile.amber.ubuntu -t oai-amber .
#
#---------------------------------------------------------------------

ARG UBUNTU_IMAGE=ubuntu:noble

FROM ${UBUNTU_IMAGE} AS amber-build
ENV DEBIAN_FRONTEND=noninteractive

# The Python development files the two programs embed Python with, then OAI's build dependencies
# from OAI's own installer, as in Dockerfile.base.ubuntu but without radio drivers
RUN apt-get update && \
    apt-get install --yes \
        build-essential \
        git \
        python3-dev \
        python3-pip && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /oai-ran/cmake_targets/tools
COPY cmake_targets/tools/build_helper ./
WORKDIR /oai-ran/cmake_targets
COPY cmake_targets/build_oai .
WORKDIR /oai-ran
COPY oaienv .
RUN /bin/sh oaienv && \
    cd cmake_targets && \
    mkdir -p log && \
    ./build_oai -I && \
    rm -rf /var/lib/apt/lists/*

# Amber's Python dependencies, at the versions Amber was tested with
RUN pip3 install --no-cache-dir --target /opt/oai-amber/python \
        simpy==4.1.2 \
        numpy==2.5.3 \
        pandas==3.0.5 \
        openpyxl==3.1.5

# Amber's dev branch by default. Docker caches this step by its text, so a rebuild with the same
# AMBER_REF does not fetch newer commits: pass a commit (as the workflow does) or use --no-cache.
# The commit used is recorded in /opt/amber/AMBER_COMMIT.
ARG AMBER_REPO=https://github.com/nayreed/Amber
ARG AMBER_REF=dev
RUN git clone --quiet ${AMBER_REPO} /opt/amber && \
    git -C /opt/amber checkout --quiet ${AMBER_REF} && \
    git -C /opt/amber rev-parse HEAD > /opt/amber/AMBER_COMMIT && \
    rm -rf /opt/amber/.git

WORKDIR /oai-ran
COPY . .
# Build for a CPU level every x86 runner and node has (AVX2, no AVX-512), not for the build machine:
# OAI otherwise targets the build CPU, and a container on another CPU dies on an illegal instruction.
RUN cmake -B build -GNinja -DENABLE_AMBER=ON -DAVX512=OFF \
        -DCMAKE_C_FLAGS=-march=x86-64-v3 -DCMAKE_CXX_FLAGS=-march=x86-64-v3 && \
    ninja -C build amber-reader amber-tag rfsimulator aiot_phy_shared rfsim_hub params_libconfig


FROM ${UBUNTU_IMAGE} AS oai-amber
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/oai-amber/bin:$PATH"
ENV PYTHONPATH="/opt/amber:/opt/oai-amber/python"
# Amber's own Python (amber.run, amber.summary, its tests) uses the A-IoT PHY of the programs
ENV AMBER_AIOT_LIB=/opt/oai-amber/bin/libaiot_phy.so

RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
        python3 \
        libpython3.12t64 \
        libconfig9 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=amber-build /opt/oai-amber/python /opt/oai-amber/python
COPY --from=amber-build /opt/amber /opt/amber
COPY --from=amber-build \
    /oai-ran/build/librfsimulator.so \
    /oai-ran/build/libparams_libconfig.so \
    /usr/local/lib/
WORKDIR /opt/oai-amber/bin
COPY --from=amber-build \
    /oai-ran/build/amber-reader \
    /oai-ran/build/amber-tag \
    /oai-ran/build/libaiot_phy.so \
    /oai-ran/build/rfsim_hub \
    ./
COPY docker/scripts/amber_compose.py ./amber-compose
# The 5G cells a scenario's [network] can name, which amber-compose copies into a room
COPY ci-scripts/conf_files/gnb.band28.u0.25prb.rfsim.dora.conf \
     ci-scripts/conf_files/nrue.uicc.conf \
     /opt/oai-amber/etc/cells/
COPY ci-scripts/yaml_files/5g_rfsimulator_aiot/ /tmp/room/
COPY ci-scripts/yaml_files/5g_rfsimulator_aiot_t1/ /tmp/room_t1/

# Fail here rather than at run time if a library is missing.
RUN ldconfig && \
    echo "---- ldd on the programs and the libraries they load ----" && \
    ldd amber-reader amber-tag rfsim_hub /usr/local/lib/librfsimulator.so /usr/local/lib/libparams_libconfig.so && \
    ! ldd amber-reader amber-tag rfsim_hub /usr/local/lib/librfsimulator.so /usr/local/lib/libparams_libconfig.so | grep "not found" && \
    python3 -c "import amber.session" && \
    python3 -c "from amber.phy import aiot; assert aiot.crc([1, 0, 1], 6)" && \
    echo "---- the checked-in 5G room is what amber-compose writes from its scenario ----" && \
    mkdir /tmp/new && cp /tmp/room/scenario.toml /tmp/new/ && \
    amber-compose --image oai-amber:latest /tmp/new/scenario.toml /tmp/new && \
    diff -r --exclude=README.md /tmp/room /tmp/new && \
    mkdir /tmp/new_t1 && cp /tmp/room_t1/scenario.toml /tmp/new_t1/ && \
    amber-compose --image oai-amber:latest /tmp/new_t1/scenario.toml /tmp/new_t1 && \
    diff -r --exclude=README.md /tmp/room_t1 /tmp/new_t1 && \
    rm -r /tmp/room /tmp/new /tmp/room_t1 /tmp/new_t1

WORKDIR /opt/oai-amber
# The image amber-compose names in the compose files it writes
ARG OAI_AMBER_IMAGE=oai-amber:latest
ENV OAI_AMBER_IMAGE=${OAI_AMBER_IMAGE}
